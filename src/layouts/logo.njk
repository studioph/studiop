---
layout: nav.njk
description: The Music of Paul Hutchings
chars: StudioP
---
<div class="logo">
    <div>
        <h1 class="site-title">
            <span>
                <a href="/" title="{{ description }}" rel="home" class="logo-letters">
                    {% for char in chars %}
                        {% set delay = 0.05 + (0.02 * loop.index0) %}
                        <span class="logo-letter" style="transition: color 0s {{ delay | round(2) }}s, background-color 0s {{ delay | round(2) }}s">{{ char }}</span>
                    {% endfor %}
                </a>
            </span>
        </h1>
        <span class="site-description">{{ description }}</span>
    </div>
</div>